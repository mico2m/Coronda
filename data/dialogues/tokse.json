{
  "speaker": "Tokse",
  "start": [
    { "if": { "veces_tokse": ">=3" }, "goto": "pesado" },
    { "if": { "hablo_tokse": true }, "goto": "otra_vez" },
    { "goto": "inicio" }
  ],
  "nodes": {
    "inicio": {
      "text": ["¡Hola! No te había visto por la plaza.", "Acá siempre pasa algo, aunque no lo parezca."],
      "next": "menu"
    },
    "otra_vez": {
      "text": "¿Otra vez vos? Contame, ¿necesitás algo?",
      "next": "menu"
    },
    "pesado": {
      "text": ["Ya hablamos un montón, ¿no?", "Bueno, preguntá lo que quieras."],
      "next": "menu"
    },
    "menu": {
      "text": "¿Necesitás algo?",
      "choices": [
        { "text": "¿Qué hay para hacer?", "next": "que_hacer" },
        { "text": "¿Hay alguna casa para visitar?", "next": "casa" },
        { "text": "Nada, gracias.", "next": "chau" }
      ]
    },
    "que_hacer": {
      "text": ["Caminá, mirá los árboles, sentate un rato.", "Y hablá con todos los que encuentres."],
      "next": "menu"
    },
    "casa": {
      "text": "Sí. Cuando estés cerca de una puerta te aparece el aviso: apretá E para entrar.",
      "set": { "sabe_de_puertas": true },
      "next": "menu"
    },
    "chau": {
      "text": "¡Cuidate! Nos vemos."
    }
  }
}
